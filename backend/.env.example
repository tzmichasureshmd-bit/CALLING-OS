DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_ENV=development
APP_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_DEMO_DATA=false

# Firebase (Google + OTP login) — optional; provider login is disabled if absent.
GOOGLE_CLIENT_ID=YOUR_FIREBASE_GOOGLE_CLIENT_ID
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json

# Supabase Storage (recording uploads)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_RECORDINGS_BUCKET=call-recordings

# Optional AI analysis provider. Leave empty to use the extractive fallback.
OPENAI_API_KEY=
