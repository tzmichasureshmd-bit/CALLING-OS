# CALLOS Web — environment configuration
# Base URL of the CALLOS FastAPI backend
VITE_API_URL=http://localhost:8000/api/v1

# Data source toggle:
#   true  -> use local mock data (development, no backend needed)
#   false -> call the real API at VITE_API_URL
# If unset, defaults to mock in dev and real API in production builds.
VITE_USE_MOCK=true
